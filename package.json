{
  "name": "aerojet-academy",
  "version": "1.0.19",
  "packageManager": "bun@1.3.12",
  "private": true,
  "type": "module",
  "description": "Aerojet Aviation Training Academy - Complete Portal System",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all": "CI=true playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "postdb:push": "bun run db:push:supabase || echo '[postdb:push] Supabase mirror skipped (SUPABASE_DATABASE_URL not set or push failed).'",
    "db:push:supabase": "node scripts/sync-supabase-schema.mjs",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "npx dotenv-cli -e .env -- tsx prisma/seed.ts",
    "db:seed:mock": "npx dotenv-cli -e .env -- tsx prisma/seed-mock-data.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "docs:html": "node scripts/build-docs-html.mjs",
    "postinstall": "prisma generate",
    "prepare": "npx husky"
  },
