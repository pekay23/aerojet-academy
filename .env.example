# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=verify-full"
DIRECT_URL="postgresql://user:password@host:5432/database?sslmode=verify-full"

# Database (Supabase - backup/replica)
SUPABASE_DATABASE_URL="postgresql://user:password@host:5432/database"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_BACKUP_ENABLED=true

# Google OAuth
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# NextAuth
NEXTAUTH_URL="https://your-domain.com"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-48"
CRON_SECRET="generate-secure-random-string"

# Portal Status
NEXT_PUBLIC_PORTAL_LIVE=true

# UploadThing (File Uploads)
UPLOADTHING_SECRET="sk_live_your-secret"
UPLOADTHING_APP_ID="your-app-id"
UPLOADTHING_TOKEN="your-token"

# Resend (Email Service)
RESEND_API_KEY="re_your-api-key"
RESEND_WEBHOOK_SECRET="whsec_your-webhook-secret"

# Admin Credentials (for seed)
ADMIN_EMAIL="admin@your-domain.com"
ADMIN_PASSWORD="your-secure-password"

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Future: Payment Integration
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""

# reCAPTCHA
RECAPTCHA_SECRET_KEY="your-recaptcha-secret"

# Safe Exam Browser (SEB)
SEB_BROWSER_EXAM_KEY="your-seb-key"

# E2E Test Credentials (optional - for local test runs)
# E2E_STAFF_EMAIL="staff@your-domain.com"
# E2E_STAFF_PASSWORD="your-password"
# E2E_STUDENT_EMAIL="student@your-domain.com"
# E2E_STUDENT_PASSWORD="your-password"
# E2E_INSTRUCTOR_EMAIL="instructor@your-domain.com"
# E2E_INSTRUCTOR_PASSWORD="your-password"
# E2E_APPLICANT_EMAIL="applicant@your-domain.com"
# E2E_APPLICANT_PASSWORD="your-password"
# E2E_EXAMINER_EMAIL="examiner@your-domain.com"
# E2E_EXAMINER_PASSWORD="your-password"
# E2E_ADMIN_EMAIL="admin@your-domain.com"
# E2E_ADMIN_PASSWORD="your-password"

# Seed Credentials (optional - for database seeding)
# SEED_EXAMINER_PASSWORD="your-password"