# =============================================================================
# Aerojet Academy — Environment Variables
# Copy this file to .env and fill in the values.
# =============================================================================

# ── Database (Required) ──────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/aerojet?sslmode=verify-full"
# DIRECT_URL is used for Prisma migrations (bypasses connection pooler)
DIRECT_URL="postgresql://user:password@host:5432/aerojet?sslmode=verify-full"
# LOCAL_DATABASE_URL="postgresql://user:password@localhost:5432/aerojet"
# AEROJET_LOCAL_DB_ADAPTER="pg"  # "pg" or "neon"

# ── Auth (Required) ──────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── Third Party (Required) ───────────────────────────────────────────────────
RESEND_API_KEY="re_your_resend_api_key"
UPLOADTHING_SECRET="sk_your_uploadthing_secret"
UPLOADTHING_APP_ID="your-uploadthing-app-id"

# ── Application (Required) ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CRON_SECRET="generate-a-random-secret"
# FROM_EMAIL="admissions@mail.aerojet-academy.com"

# ── Supabase (Optional — backup/replica) ─────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# SUPABASE_DATABASE_URL="postgresql://..."
# SUPABASE_BACKUP_ENABLED="true"  # Set to true to match Vercel production (default: true)

# ── Stripe (Optional — payment processing stub) ─────────────────────────────
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_PUBLISHABLE_KEY="pk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Webhooks (Optional) ─────────────────────────────────────────────────────
# RESEND_WEBHOOK_SECRET="whsec_..."

# ── Upstash Redis (Optional — distributed rate limiting) ────────────────────
# UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ── WebAuthn / Passkeys (Optional) ──────────────────────────────────────────
# NEXT_PUBLIC_DOMAIN="localhost"  # rpID for passkeys (domain, not IP)
