model Permission {
  /// Stable key (e.g. "MANAGE_REFERRALS"). PK so RoleGrant.permissionKey can FK to it.
  key         String      @id
  label       String
  description String?
  category    String      @default("GENERAL")
  /// True for keys seeded from the PERMISSIONS enum (cannot be deleted via UI)
  isSystem    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  grants      RoleGrant[]

  @@index([category])
  @@map("permissions")
}

model RoleGrant {
  id            String          @id @default(cuid())
  scope         PermissionScope
  /// Role name (e.g. "STAFF") when scope=ROLE, or User.id when scope=USER
  targetKey     String
  permissionKey String
  grantedById   String?
  expiresAt     DateTime?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  grantedBy     User?           @relation("RoleGrantCreator", fields: [grantedById], references: [id])
  permission    Permission      @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@unique([scope, targetKey, permissionKey])
  @@index([targetKey])
  @@index([permissionKey])
  @@index([expiresAt])
  @@map("role_grants")
}

