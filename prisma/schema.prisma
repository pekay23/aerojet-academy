generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String               @id @default(cuid())
  email                     String               @unique
  personalEmail             String?
  academyEmail              String?              @unique
  password                  String?
  role                      UserRole             @default(APPLICANT)
  status                    UserStatus           @default(PENDING)
  registrationCode          String?              @unique
  registrationFee           Decimal              @default(350.00) @db.Decimal(10, 2)
  registrationCurrency      String               @default("EUR")
  registrationPaid          Boolean              @default(false)
  paymentProofUrl           String?
  paymentApprovedAt         DateTime?
  paymentApprovedBy         String?
  programmeChoice           ProgrammeChoice?
  isAmbassador              Boolean              @default(false)
  referralCode              String?              @unique
  successfulReferrals       Int                  @default(0)
  mustChangePassword        Boolean              @default(false)
  passwordChanged           Boolean              @default(false)
  emailVerified             DateTime?
  verifyToken               String?              @unique
  verifyTokenExpires        DateTime?
  loginAttempts             Int                  @default(0)
  lockedUntil               DateTime?
  lastLoginAt               DateTime?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  deletedAt                 DateTime?
  selectedLicenseCategories String[]             @default([])
  settings                  Json?                @default("{}")
  passwordChangedAt         DateTime?
  marketingOptOut           Boolean              @default(false)
  adminNotesAuthored        AdminNote[]          @relation("AdminNoteAuthor")
  attendanceRecords         AttendanceRecord[]
  auditLogs                 AuditLog[]
  bookingEntitlements       BookingEntitlement[]
  enrollments               Enrollment[]
  examAttendances           ExamAttendance[]
  examBookings              ExamBooking[]
  examBundles               ExamBundle[]
  examExemptions            ExamExemption[]
  examResults               ExamResult[]
  examSittingAssignments    ExamSittingAssignment[]
  examinerProfile           Examiner?
  fileUploads               FileUpload[]
  fullTimeEnrollments       FullTimeEnrollment[]
  grades                    Grade[]
  instructorProfile         InstructorProfile?
  invoices                  Invoice[]
  messagesReceived          Message[]            @relation("ReceivedMessages")
  messagesSent              Message[]            @relation("SentMessages")
  modularEnrollments        ModularEnrollment[]
  newsArticles              NewsArticle[]
  notificationsSent         Notification[]       @relation("SentNotifications")
  notificationsReceived     Notification[]       @relation("ReceivedNotifications")
  payments                  Payment[]
  poolMemberships           PoolMembership[]
  waitlists                 PoolWaitlist[]
  profile                   Profile?
  referralsReceived         Referral[]           @relation("ReferralsReceived")
  referralsMade             Referral[]           @relation("ReferralsMade")
  staffProfile              StaffProfile?
  studentCalendarEvents     StudentCalendarEvent[]
  adminCalendarEventsCreated AdminCalendarEvent[] @relation("AdminCalendarEventCreator")
  adminCalendarEventsTargeted AdminCalendarEvent[] @relation("AdminCalendarEventTarget")
  studentProfile            StudentProfile?
  tuitionBookings           TuitionBooking[]
  createdTuitionRuns        TuitionRun[]         @relation("CreatedTuitionRuns")
  wallet                    Wallet?
  academicIntents           AcademicIntent[]

  @@index([email])
  @@index([academyEmail])
  @@index([registrationCode])
  @@index([role, status, deletedAt])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("users")
}

model Profile {
  id                       String    @id @default(cuid())
  userId                   String    @unique
  firstName                String
  middleName               String?
  lastName                 String
  dateOfBirth              DateTime?
  gender                   String?
  nationality              String?
  phone                    String?
  alternatePhone           String?
  address                  String?
  city                     String?
  state                    String?
  country                  String?
  postalCode               String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  profilePhotoUrl          String?
  idDocumentUrl            String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("profiles")
}

model StudentProfile {
  id                        String                 @id @default(cuid())
  userId                    String                 @unique
  studentId                 String                 @unique
  enrollmentType            EnrollmentType?
  programmeChoice           ProgrammeChoice?
  enrollmentStatus          EnrollmentStatus       @default(ENROLLED)
  enrollmentDate            DateTime               @default(now())
  graduationDate            DateTime?
  studyPathwayLockedAt      DateTime?
  studyPathwayLocked        Boolean                @default(false)
  studyPathwayLastChangedBy String?
  studyPathwayChangeReason  String?
  currentYearNumber         Int                    @default(1)
  currentSemesterNumber     Int                    @default(1)
  CGPA                      Decimal?               @db.Decimal(3, 2)
  academicYearId            String?
  semesterId                String?
  preferredModules          String[]
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  pathwayId                 String?
  fundingSource             FundingSource          @default(SELF_FUNDED)
  notes                     AdminNote[]
  licenseTargets            StudentLicenseTarget[]
  academicYear              AcademicYear?          @relation(fields: [academicYearId], references: [id])
  pathwayRel                StudyPathwayModel?     @relation(fields: [pathwayId], references: [id])
  semester                  Semester?              @relation(fields: [semesterId], references: [id])
  user                      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([enrollmentType])
  @@index([enrollmentStatus])
  @@index([academicYearId])
  @@index([semesterId])
  @@map("student_profiles")
}

model AdminNote {
  id               String         @id @default(cuid())
  studentProfileId String
  content          String
  createdBy        String
  updatedAt        DateTime       @updatedAt
  createdAt        DateTime       @default(now())
  deletedAt        DateTime?
  author           User           @relation("AdminNoteAuthor", fields: [createdBy], references: [id])
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([studentProfileId])
  @@index([createdBy])
  @@index([deletedAt])
  @@map("admin_notes")
}

model ExamExemption {
  id                   String   @id @default(cuid())
  userId               String
  moduleCode           String
  exemptedCategory     String
  grantedByCategory    String
  grantedByComponentId String?
  notes                String?
  createdAt            DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleCode, exemptedCategory])
  @@index([userId])
  @@map("exam_exemptions")
}

model InstructorProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  employeeId        String    @unique
  department        String?
  specialization    String?
  qualifications    String?
  hireDate          DateTime?
  modulesQualified  String[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  classesInstructed Class[]
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("instructor_profiles")
}

model StaffProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  employeeId  String    @unique
  department  String?
  position    String?
  hireDate    DateTime?
  permissions Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("staff_profiles")
}

model LicenseCategory {
  id             String                     @id @default(cuid())
  code           String                     @unique
  name           String
  description    String?
  academicTerms  AcademicTerm[]
  requirements   LicenseModuleRequirement[]
  studentTargets StudentLicenseTarget[]

  @@map("license_categories")
}

model LicenseModuleRequirement {
  id                String          @id @default(cuid())
  licenseCategoryId String
  courseId          String
  course            Course          @relation(fields: [courseId], references: [id])
  licenseCategory   LicenseCategory @relation(fields: [licenseCategoryId], references: [id])

  @@unique([licenseCategoryId, courseId])
  @@map("license_module_requirements")
}

model StudyPathwayModel {
  id                     String            @id @default(cuid())
  code                   String            @unique
  name                   String
  description            String?
  requiresAutoEnrollment Boolean           @default(false)
  grantsTuitionAccess    Boolean           @default(true)
  includesOjt            Boolean           @default(false)
  academicTerms          AcademicTerm[]
  profiles               StudentProfile[]
  resources              GeneralResource[] @relation("GeneralResourceToStudyPathwayModel")

  @@map("study_pathways_relational")
}

model AcademicTerm {
  id                String                 @id @default(cuid())
  pathwayId         String
  yearNumber        Int
  semesterNumber    Int
  startDate         DateTime?
  endDate           DateTime?
  licenseCategoryId String?
  licenseCategory   LicenseCategory?       @relation(fields: [licenseCategoryId], references: [id])
  pathway           StudyPathwayModel      @relation(fields: [pathwayId], references: [id])
  courseAssignments TermCourseAssignment[]

  @@unique([pathwayId, yearNumber, semesterNumber, licenseCategoryId])
  @@index([licenseCategoryId])
  @@map("academic_terms")
}

model TermCourseAssignment {
  id       String       @id @default(cuid())
  termId   String
  courseId String
  course   Course       @relation(fields: [courseId], references: [id])
  term     AcademicTerm @relation(fields: [termId], references: [id])

  @@unique([termId, courseId])
  @@map("term_course_assignments")
}

model StudentLicenseTarget {
  id                String          @id @default(cuid())
  studentProfileId  String
  licenseCategoryId String
  licenseCategory   LicenseCategory @relation(fields: [licenseCategoryId], references: [id])
  studentProfile    StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, licenseCategoryId])
  @@map("student_license_targets")
}

model ExamComponent {
  id              String            @id @default(cuid())
  courseId        String
  code            String            @unique
  name            String
  type            ExamComponentType
  duration        Int
  individualPrice Decimal?          @default(520.00) @db.Decimal(10, 2)
  poolPrice       Decimal?          @default(300.00) @db.Decimal(10, 2)
  categoryCode    String?
  questionCount   Int?
  bookings        ExamBooking[]
  course          Course            @relation(fields: [courseId], references: [id])
  examAttendances ExamAttendance[]
  exams           Exam[]
  sittings        ExamSitting[]
  poolMemberships PoolMembership[]
  waitlist        PoolWaitlist[]

  @@index([courseId, categoryCode, type])
  @@map("exam_components")
}

model Course {
  id                     String                     @id @default(cuid())
  code                   String                     @unique
  name                   String
  description            String?
  categoryId             String?
  moduleType             CourseModuleType?
  duration               Int?
  price                  Decimal                    @db.Decimal(10, 2)
  currency               String                     @default("EUR")
  isActive               Boolean                    @default(true)
  requiresPrerequisite   Boolean                    @default(false)
  prerequisites          String[]
  syllabusUrl            String?
  materialsUrl           String?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  applicableCategories   String[]
  estimatedStudyHoursMax Int?
  estimatedStudyHoursMin Int?
  subtitle               String?
  topics                 String[]
  hasCombinedExam        Boolean                    @default(false)
  classes                Class[]
  category               CourseCategory?            @relation(fields: [categoryId], references: [id])
  enrollments            Enrollment[]
  examBookings           ExamBooking[]
  examComponents         ExamComponent[]
  licenseRequirements    LicenseModuleRequirement[]
  termAssignments        TermCourseAssignment[]
  programmeYears         ProgrammeYear[]            @relation("CourseToProgrammeYear")
  resources              GeneralResource[]          @relation("CourseToResource")

  @@index([code])
  @@index([categoryId])
  @@index([isActive])
  @@map("courses")
}

model Enrollment {
  id              String           @id @default(cuid())
  userId          String
  courseId        String
  academicYearId  String?
  semesterId      String?
  enrolledAt      DateTime         @default(now())
  approvedAt      DateTime?
  completedAt     DateTime?
  amountPaid      Decimal?         @db.Decimal(10, 2)
  paymentProofUrl String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  status          EnrollmentStatus @default(PENDING)
  academicYear    AcademicYear?    @relation(fields: [academicYearId], references: [id])
  course          Course           @relation(fields: [courseId], references: [id])
  semester        Semester?        @relation(fields: [semesterId], references: [id])
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  grades          Grade[]

  @@unique([userId, courseId, semesterId])
  @@index([userId])
  @@index([courseId])
  @@index([status])
  @@index([academicYearId])
  @@index([semesterId])
  @@index([deletedAt])
  @@map("enrollments")
}

model Class {
  id                String             @id @default(cuid())
  courseId          String
  instructorId      String?
  name              String
  description       String?
  academicYearId    String?
  semesterId        String?
  startDate         DateTime
  endDate           DateTime
  schedule          Json?
  recurrenceType    RecurrenceType     @default(NONE)
  recurrenceDays    String? // For CUSTOM: comma-separated days "0,1,2,3,4,5,6" (Sun-Sat)
  recurrenceUntil   DateTime?
  maxStudents       Int                @default(28)
  currentStudents   Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  attendanceRecords AttendanceRecord[]
  examAttendances   ExamAttendance[]
  academicYear      AcademicYear?      @relation(fields: [academicYearId], references: [id])
  course            Course             @relation(fields: [courseId], references: [id])
  instructor           InstructorProfile?   @relation(fields: [instructorId], references: [id])
  semester             Semester?            @relation(fields: [semesterId], references: [id])
  adminCalendarEvents  AdminCalendarEvent[]

  @@index([courseId])
  @@index([instructorId])
  @@index([startDate, endDate])
  @@map("classes")
}

model AttendanceRecord {
  id          String   @id @default(cuid())
  classId     String
  userId      String
  date        DateTime
  status      String
  minutesLate Int?
  notes       String?
  recordedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId, date])
  @@index([classId])
  @@index([userId])
  @@index([date])
  @@map("attendance_records")
}

model Grade {
  id             String     @id @default(cuid())
  userId         String
  enrollmentId   String
  assessmentType String
  assessmentName String
  score          Decimal    @db.Decimal(5, 2)
  maxScore       Decimal    @db.Decimal(5, 2)
  percentage     Decimal    @db.Decimal(5, 2)
  grade          String?
  mcqScore       Decimal?   @db.Decimal(5, 2)
  essay1Score    Decimal?   @db.Decimal(5, 2)
  essay2Score    Decimal?   @db.Decimal(5, 2)
  assessmentDate DateTime
  gradedBy       String?
  comments       String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?
  enrollment     Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([enrollmentId])
  @@index([assessmentDate])
  @@index([deletedAt])
  @@map("grades")
}

model ExamEvent {
  id                   String              @id @default(cuid())
  name                 String
  startDate            DateTime
  endDate              DateTime
  location             String?
  joinDeadline         DateTime?
  paymentDeadline      DateTime
  minRevenueTarget     Decimal             @default(25000.00) @db.Decimal(10, 2)
  minRevenueCurrency   String              @default("EUR")
  resitFee             Decimal             @default(480.00) @db.Decimal(10, 2)
  resitFeeCurrency     String              @default("EUR")
  lateBookingSurcharge Decimal             @default(50.00) @db.Decimal(10, 2)
  lateBookingDays      Int                 @default(14)
  minCandidateTarget   Int?
  minSeatVolumeTarget  Int?
  viabilityMode        EventViabilityMode  @default(HYBRID)
  isExaminerConfirmed  Boolean             @default(false)
  confirmedExaminerCount Int               @default(0)
  status               EventStatus         @default(DRAFT)
  overrideStatus       EventOverrideStatus @default(NONE)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  createdBy            String?
  deletedAt            DateTime?
  examAttendances      ExamAttendance[]
  examBookings         ExamBooking[]
  sittings             ExamSitting[]
  pools                ExamPool[]
  exams                Exam[]
  adminCalendarEvents  AdminCalendarEvent[]

  @@index([status])
  @@index([startDate, endDate])
  @@index([paymentDeadline])
  @@index([deletedAt])
  @@map("exam_events")
}

model ExamPool {
  id                 String           @id @default(cuid())
  eventId            String
  name               String
  examDate           DateTime
  examStartTime      DateTime
  examEndTime        DateTime
  minCandidates      Int              @default(25)
  maxCandidates      Int              @default(28)
  moduleDiversityCap Int              @default(4)
  currentMemberCount Int              @default(0)
  status             PoolStatus       @default(DRAFT)
  preSeedModules     String[]
  allowedModules     String[]
  seatPrice          Decimal          @default(300.00) @db.Decimal(10, 2)
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  confirmedAt        DateTime?
  createdBy          String?
  dayNumber          Int              @default(1)
  isAutoPool         Boolean          @default(false)
  isPublicVisible    Boolean          @default(true)
  totalDemandSeats   Int              @default(0)
  guaranteedSeats    Int              @default(0)
  poolNumber         Int?
  poolLabel          String?
  poolType           PoolType         @default(STANDARD)
  redistributedAt    DateTime?
  timeSlot           TimeSlot?
  venue              String?
  event              ExamEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberships        PoolMembership[]
  waitlist           PoolWaitlist[]

  @@index([eventId])
  @@index([status])
  @@index([examDate, examStartTime])
  @@index([eventId, status])
  @@index([eventId, poolType])
  @@map("exam_pools")
}

model PoolMembership {
  id               String           @id @default(cuid())
  poolId           String
  userId           String
  examComponentId  String?
  status           MembershipStatus @default(RESERVED)
  amountReserved   Decimal          @db.Decimal(10, 2)
  amountPaid       Decimal?         @db.Decimal(10, 2)
  discountType     String?
  referralCode     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  confirmedAt      DateTime?
  paidAt           DateTime?
  paymentReference String?
  bookingId        String?
  sourceAutoPoolId String?
  deletedAt        DateTime?
  booking          ExamBooking?     @relation(fields: [bookingId], references: [id])
  examAttendance   ExamAttendance?
  examComponent    ExamComponent?   @relation(fields: [examComponentId], references: [id])
  pool             ExamPool         @relation(fields: [poolId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([poolId, userId])
  @@index([poolId])
  @@index([userId])
  @@index([status])
  @@index([examComponentId])
  @@index([poolId, status])
  @@index([bookingId])
  @@index([deletedAt])
  @@map("pool_memberships")
}

model PoolWaitlist {
  id              String        @id @default(cuid())
  poolId          String
  userId          String
  examComponentId String
  priority        Int           @default(0)
  status          String        @default("PENDING")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  examComponent   ExamComponent @relation(fields: [examComponentId], references: [id])
  pool            ExamPool      @relation(fields: [poolId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([poolId, userId, examComponentId])
  @@index([poolId])
  @@index([userId])
  @@index([examComponentId])
  @@map("pool_waitlist")
}

model Wallet {
  id               String              @id @default(cuid())
  userId           String              @unique
  balance          Decimal             @default(0) @db.Decimal(10, 2)
  reservedBalance  Decimal             @default(0) @db.Decimal(10, 2)
  availableBalance Decimal             @default(0) @db.Decimal(10, 2)
  currency         String              @default("EUR")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  transactions     WalletTransaction[]
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([availableBalance])
  @@map("wallets")
}

model WalletTransaction {
  id                 String              @id @default(cuid())
  walletId           String
  type               TransactionType
  amount             Decimal             @db.Decimal(10, 2)
  balanceBefore      Decimal?            @db.Decimal(10, 2)
  balanceAfter       Decimal?            @db.Decimal(10, 2)
  reservedBefore     Decimal?            @db.Decimal(10, 2)
  reservedAfter      Decimal?            @db.Decimal(10, 2)
  availableBefore    Decimal?            @db.Decimal(10, 2)
  availableAfter     Decimal?            @db.Decimal(10, 2)
  referenceType      String?
  referenceId        String?
  description        String?
  metadata           Json?
  createdAt          DateTime            @default(now())
  createdBy          String?
  examBookings       ExamBooking[]
  modularEnrollments ModularEnrollment[]
  paymentMilestones  PaymentMilestone[]
  tuitionBookings    TuitionBooking[]
  wallet             Wallet              @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([type])
  @@index([createdAt(sort: Desc)])
  @@index([referenceType, referenceId])
  @@index([walletId, createdAt(sort: Desc)])
  @@map("wallet_transactions")
}

model Exam {
  id              String        @id @default(cuid())
  examComponentId String
  eventId         String?
  name            String
  description     String?
  examDate        DateTime
  duration        Int
  passingScore    Decimal       @db.Decimal(5, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  attendances     ExamAttendance[]
  bookings        ExamBooking[]
  results         ExamResult[]
  event           ExamEvent?    @relation(fields: [eventId], references: [id])
  examComponent   ExamComponent @relation(fields: [examComponentId], references: [id])

  @@index([examComponentId])
  @@index([examDate])
  @@map("exams")
}

model ExamBooking {
  id                 String             @id @default(cuid())
  userId             String
  examId             String?
  eventId            String?
  examComponentId    String?
  bookingType        BookingType        @default(INDIVIDUAL)
  moduleCode         String?
  amountPaid         Decimal            @db.Decimal(10, 2)
  guaranteeType      BookingGuaranteeType @default(INDIVIDUAL_GUARANTEED)
  demandStatus       BookingDemandStatus @default(DEMAND_CAPTURED)
  status             PaymentStatus      @default(PENDING)
  walletTxnId        String?
  bookedAt           DateTime           @default(now())
  examDate           DateTime?
  preferredSessionType SessionType?
  guaranteedSeat     Boolean            @default(false)
  executedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  attemptType        String?
  bookingGroupRef    String?
  courseId           String?
  autoPoolId         String?
  rolloverFromBookingId String?
  rolloverToEventId  String?
  cancellationReason String?
  cancelledAt        DateTime?
  cancelledBy        String?
  groupName          String?
  groupRepId         String?
  isResit            Boolean            @default(false)
  refundAmount       Decimal?           @db.Decimal(10, 2)
  combinedGroupRef   String?
  deletedAt          DateTime?
  result             String?
  score              Decimal?           @db.Decimal(5, 2)
  percentage         Decimal?           @db.Decimal(5, 2)
  examCategory       ExamCategory       @default(OFFICIAL_EASA)
  course             Course?            @relation(fields: [courseId], references: [id])
  event              ExamEvent?         @relation(fields: [eventId], references: [id])
  examComponent      ExamComponent?     @relation(fields: [examComponentId], references: [id])
  exam               Exam?              @relation(fields: [examId], references: [id])
  examAttendance     ExamAttendance?
  sittingAssignments ExamSittingAssignment[]
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletTransaction  WalletTransaction? @relation(fields: [walletTxnId], references: [id])
  poolMemberships    PoolMembership[]

  @@index([userId])
  @@index([examId])
  @@index([eventId])
  @@index([status])
  @@index([bookingGroupRef])
  @@index([examComponentId])
  @@index([moduleCode])
  @@index([autoPoolId])
