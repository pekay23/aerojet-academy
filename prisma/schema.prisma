  /// * True when this row was added by the system seed (cannot be deleted via UI).
  isSystem    Boolean               @default(false)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  createdById String?

  @@index([category])
  @@map("email_registry_entries")
}

model EmailDelivery {
  id        String              @id @default(cuid())
  recipient String
  subject   String
  status    EmailDeliveryStatus
  /// Resend message id when the send succeeded
  messageId String?
  /// Last error message when status=FAILED
  error     String?
  /// Number of attempts spent (1 = first-try success)
  attempts  Int                 @default(1)
  /// "registration", "password-reset", "exam-booking", etc.
  template  String?
  /// Optional User.id when the recipient maps to a known account
  userId    String?
  createdAt DateTime            @default(now())

  @@index([status, createdAt(sort: Desc)])
  @@index([recipient])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("email_deliveries")
}

