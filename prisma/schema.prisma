generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String               @id @default(cuid())
  email                 String               @unique
  personalEmail         String?
  academyEmail          String?              @unique
  password              String?
  role                  UserRole             @default(APPLICANT)
  status                UserStatus           @default(PENDING)
  registrationCode      String?              @unique
  registrationFee       Decimal              @default(350.00) @db.Decimal(10, 2)
  registrationCurrency  String               @default("EUR")
  registrationPaid      Boolean              @default(false)
  paymentProofUrl       String?
  paymentApprovedAt     DateTime?
  paymentApprovedBy     String?
  programmeChoice            ProgrammeChoice?
  selectedLicenseCategories  String[]             @default([])
  isAmbassador               Boolean              @default(false)
  marketingOptOut        Boolean              @default(false)
  referralCode          String?              @unique
  successfulReferrals   Int                  @default(0)
  mustChangePassword    Boolean              @default(false)
  passwordChanged       Boolean              @default(false)
  passwordChangedAt     DateTime?
  emailVerified         DateTime?
  verifyToken           String?              @unique
  verifyTokenExpires    DateTime?
  loginAttempts         Int                  @default(0)
  lockedUntil           DateTime?
  lastLoginAt           DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  deletedAt             DateTime?
  attendanceRecords     AttendanceRecord[]
  auditLogs             AuditLog[]
  enrollments           Enrollment[]
  examBookings          ExamBooking[]
  examBundles           ExamBundle[]
  examResults           ExamResult[]
  fileUploads           FileUpload[]
  fullTimeEnrollments   FullTimeEnrollment[]
  grades                Grade[]
  instructorProfile     InstructorProfile?
  invoices              Invoice[]
  messagesReceived      Message[]            @relation("ReceivedMessages")
  messagesSent          Message[]            @relation("SentMessages")
  modularEnrollments    ModularEnrollment[]
  newsArticles          NewsArticle[]
  notificationsSent     Notification[]       @relation("SentNotifications")
  notificationsReceived Notification[]       @relation("ReceivedNotifications")
  payments              Payment[]
  poolMemberships       PoolMembership[]
  waitlists             PoolWaitlist[]
  profile               Profile?
  referralsReceived     Referral[]           @relation("ReferralsReceived")
  referralsMade         Referral[]           @relation("ReferralsMade")
  staffProfile          StaffProfile?
  studentProfile        StudentProfile?
  tuitionBookings       TuitionBooking[]
  createdTuitionRuns    TuitionRun[]         @relation("CreatedTuitionRuns")
  bookingEntitlements   BookingEntitlement[]
  adminNotesAuthored    AdminNote[]          @relation("AdminNoteAuthor")
  examExemptions        ExamExemption[]
  wallet                Wallet?
  settings              Json?                @default("{}")

  @@index([email])
  @@index([academyEmail])
  @@index([registrationCode])
  @@index([role, status])
  @@index([createdAt])
  @@map("users")
}

model Profile {
  id                       String    @id @default(cuid())
  userId                   String    @unique
  firstName                String
  middleName               String?
  lastName                 String
  dateOfBirth              DateTime?
  gender                   String?
  nationality              String?
  phone                    String?
  alternatePhone           String?
  address                  String?
  city                     String?
  state                    String?
  country                  String?
  postalCode               String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  profilePhotoUrl          String?
  idDocumentUrl            String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("profiles")
}

model StudentProfile {
  id                        String                 @id @default(cuid())
  userId                    String                 @unique
  studentId                 String                 @unique
  enrollmentType            EnrollmentType?
  programmeChoice           ProgrammeChoice?
  enrollmentStatus          EnrollmentStatus       @default(ENROLLED)
  enrollmentDate            DateTime               @default(now())
  graduationDate            DateTime?
  studyPathwayLockedAt      DateTime?
  studyPathwayLocked        Boolean                @default(false)
  studyPathwayLastChangedBy String?
  studyPathwayChangeReason  String?
  currentYearNumber         Int                    @default(1)
  currentSemesterNumber     Int                    @default(1)
  CGPA                      Decimal?               @db.Decimal(3, 2)
  academicYearId            String?
  semesterId                String?
  preferredModules          String[]
  fundingSource             FundingSource          @default(SELF_FUNDED)
  adminNotes                String?                @db.Text
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  pathwayId                 String?
  licenseTargets            StudentLicenseTarget[]
  notes                     AdminNote[]
  academicYear              AcademicYear?          @relation(fields: [academicYearId], references: [id])
  pathwayRel                StudyPathwayModel?     @relation(fields: [pathwayId], references: [id])
  semester                  Semester?              @relation(fields: [semesterId], references: [id])
  user                      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([enrollmentType])
  @@index([enrollmentStatus])
  @@index([academicYearId])
  @@index([semesterId])
  @@map("student_profiles")
}

model AdminNote {
  id               String         @id @default(cuid())
  studentProfileId String
  content          String         @db.Text
  createdBy        String
  updatedAt        DateTime       @updatedAt
  createdAt        DateTime       @default(now())
  deletedAt        DateTime?
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  author           User           @relation("AdminNoteAuthor", fields: [createdBy], references: [id])

  @@index([studentProfileId])
  @@index([createdBy])
  @@index([deletedAt])
  @@map("admin_notes")
}

model ExamExemption {
  id                   String   @id @default(cuid())
  userId               String
  moduleCode           String
  exemptedCategory     String
  grantedByCategory    String
  grantedByComponentId String?
  notes                String?
  createdAt            DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleCode, exemptedCategory])
  @@index([userId])
  @@map("exam_exemptions")
}

model InstructorProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  employeeId        String    @unique
  department        String?
  specialization    String?
  qualifications    String?
  hireDate          DateTime?
  modulesQualified  String[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  classesInstructed Class[]
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("instructor_profiles")
}

model StaffProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  employeeId  String    @unique
  department  String?
  position    String?
  hireDate    DateTime?
  permissions Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("staff_profiles")
}

model LicenseCategory {
  id             String                     @id @default(cuid())
  code           String                     @unique
  name           String
  description    String?
  requirements   LicenseModuleRequirement[]
  studentTargets StudentLicenseTarget[]

  @@map("license_categories")
}

model LicenseModuleRequirement {
  id                String          @id @default(cuid())
  licenseCategoryId String
  courseId          String
  course            Course          @relation(fields: [courseId], references: [id])
  licenseCategory   LicenseCategory @relation(fields: [licenseCategoryId], references: [id])

  @@unique([licenseCategoryId, courseId])
  @@map("license_module_requirements")
}

model StudyPathwayModel {
  id                     String           @id @default(cuid())
  code                   String           @unique
  name                   String
  description            String?
  requiresAutoEnrollment Boolean          @default(false)
  grantsTuitionAccess    Boolean          @default(true)
  includesOjt            Boolean          @default(false)
  academicTerms          AcademicTerm[]
  profiles               StudentProfile[]

  @@map("study_pathways_relational")
}

model AcademicTerm {
  id                String                 @id @default(cuid())
  pathwayId         String
  yearNumber        Int
  semesterNumber    Int
  startDate         DateTime?
  endDate           DateTime?
  pathway           StudyPathwayModel      @relation(fields: [pathwayId], references: [id])
  courseAssignments TermCourseAssignment[]

  @@map("academic_terms")
}

model TermCourseAssignment {
  id       String       @id @default(cuid())
  termId   String
  courseId String
  course   Course       @relation(fields: [courseId], references: [id])
  term     AcademicTerm @relation(fields: [termId], references: [id])

  @@unique([termId, courseId])
  @@map("term_course_assignments")
}

model StudentLicenseTarget {
  id                String          @id @default(cuid())
  studentProfileId  String
  licenseCategoryId String
  licenseCategory   LicenseCategory @relation(fields: [licenseCategoryId], references: [id])
  studentProfile    StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, licenseCategoryId])
  @@map("student_license_targets")
}

model ExamComponent {
  id              String           @id @default(cuid())
  courseId        String
  code            String           @unique
  name            String
  type            ExamComponentType
  duration        Int
  questionCount   Int?
  categoryCode    String?
  individualPrice Decimal?         @default(520.00) @db.Decimal(10, 2)
  poolPrice       Decimal?         @default(300.00) @db.Decimal(10, 2)
  bookings        ExamBooking[]
  course          Course           @relation(fields: [courseId], references: [id])
  exams           Exam[]
  poolMemberships PoolMembership[]
  waitlist        PoolWaitlist[]

  @@index([courseId, categoryCode, type])
  @@map("exam_components")
}

model Course {
  id                   String                     @id @default(cuid())
  code                 String                     @unique
  name                 String
  description          String?
  categoryId           String?
  moduleType           CourseModuleType?
  duration             Int?
  price                Decimal                    @db.Decimal(10, 2)
  currency             String                     @default("EUR")
  isActive             Boolean                    @default(true)
  requiresPrerequisite Boolean                    @default(false)
  prerequisites        String[]
  subtitle             String?
  topics               String[]
  estimatedStudyHoursMin Int?
  estimatedStudyHoursMax Int?
  applicableCategories String[]
  hasCombinedExam      Boolean                    @default(false)
  syllabusUrl          String?
  materialsUrl         String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  classes              Class[]
  category             CourseCategory?            @relation(fields: [categoryId], references: [id])
  enrollments          Enrollment[]
  examComponents       ExamComponent[]
  licenseRequirements  LicenseModuleRequirement[]
  termAssignments      TermCourseAssignment[]
  programmeYears       ProgrammeYear[]            @relation("CourseToProgrammeYear")
  examBookings         ExamBooking[]

  @@index([code])
  @@index([categoryId])
  @@index([isActive])
  @@map("courses")
}

model Enrollment {
  id              String        @id @default(cuid())
  userId          String
  courseId        String
  status          String        @default("PENDING")
  academicYearId  String?
  semesterId      String?
  enrolledAt      DateTime      @default(now())
  approvedAt      DateTime?
  completedAt     DateTime?
  amountPaid      Decimal?      @db.Decimal(10, 2)
  paymentProofUrl String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  academicYear    AcademicYear? @relation(fields: [academicYearId], references: [id])
  course          Course        @relation(fields: [courseId], references: [id])
  semester        Semester?     @relation(fields: [semesterId], references: [id])
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  grades          Grade[]

  @@unique([userId, courseId, semesterId])
  @@index([userId])
  @@index([courseId])
  @@index([status])
  @@index([academicYearId])
  @@index([semesterId])
  @@index([deletedAt])
  @@map("enrollments")
}

model Class {
  id                String             @id @default(cuid())
  courseId          String
  instructorId      String?
  name              String
  description       String?
  academicYearId    String?
  semesterId        String?
  startDate         DateTime
  endDate           DateTime
  schedule          Json?
  maxStudents       Int                @default(28)
  currentStudents   Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  attendanceRecords AttendanceRecord[]
  academicYear      AcademicYear?      @relation(fields: [academicYearId], references: [id])
  course            Course             @relation(fields: [courseId], references: [id])
  instructor        InstructorProfile? @relation(fields: [instructorId], references: [id])
  semester          Semester?          @relation(fields: [semesterId], references: [id])

  @@index([courseId])
  @@index([instructorId])
  @@index([startDate, endDate])
  @@map("classes")
}

model AttendanceRecord {
  id          String   @id @default(cuid())
  classId     String
  userId      String
  date        DateTime
  status      String
  minutesLate Int?
  notes       String?
  recordedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId, date])
  @@index([classId])
  @@index([userId])
  @@index([date])
  @@map("attendance_records")
}

model Grade {
  id             String     @id @default(cuid())
  userId         String
  enrollmentId   String
  assessmentType String
  assessmentName String
  score          Decimal    @db.Decimal(5, 2)
  maxScore       Decimal    @db.Decimal(5, 2)
  percentage     Decimal    @db.Decimal(5, 2)
  grade          String?
  mcqScore       Decimal?   @db.Decimal(5, 2)
  essay1Score    Decimal?   @db.Decimal(5, 2)
  essay2Score    Decimal?   @db.Decimal(5, 2)
  assessmentDate DateTime
  gradedBy       String?
  comments       String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?
  enrollment     Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([enrollmentId])
  @@index([assessmentDate])
  @@index([deletedAt])
  @@map("grades")
}

model ExamEvent {
  id                   String              @id @default(cuid())
  name                 String
  startDate            DateTime
  endDate              DateTime
  location             String?
  joinDeadline         DateTime?
  paymentDeadline      DateTime
  minRevenueTarget     Decimal             @default(25000.00) @db.Decimal(10, 2)
  minRevenueCurrency   String              @default("EUR")
  resitFee             Decimal             @default(480.00) @db.Decimal(10, 2)
  resitFeeCurrency     String              @default("EUR")
  lateBookingSurcharge Decimal             @default(50.00) @db.Decimal(10, 2)
  lateBookingDays      Int                 @default(14)
  status               EventStatus         @default(DRAFT)
  overrideStatus       EventOverrideStatus @default(NONE)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?
  createdBy            String?
  examBookings         ExamBooking[]
  pools                ExamPool[]
  exams                Exam[]

  @@index([status])
  @@index([startDate, endDate])
  @@index([paymentDeadline])
  @@index([deletedAt])
  @@map("exam_events")
}

model ExamPool {
  id                 String           @id @default(cuid())
  eventId            String
  name               String
  examDate           DateTime
  examStartTime      DateTime
  examEndTime        DateTime
  minCandidates      Int              @default(25)
  maxCandidates      Int              @default(28)
  moduleDiversityCap Int              @default(4)
  currentMemberCount Int              @default(0)
  status             PoolStatus       @default(DRAFT)
  poolType           PoolType         @default(STANDARD)
  dayNumber          Int              @default(1)
  timeSlot           TimeSlot?
  poolLabel          String?
  isAutoPool         Boolean          @default(false)
  redistributedAt    DateTime?
  preSeedModules     String[]
  allowedModules     String[]
  seatPrice          Decimal          @default(300.00) @db.Decimal(10, 2)
  notes              String?
  venue              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  confirmedAt        DateTime?
  createdBy          String?
  event              ExamEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberships        PoolMembership[]
  waitlist           PoolWaitlist[]

  @@index([eventId])
  @@index([status])
  @@index([examDate, examStartTime])
  @@index([eventId, status])
  @@index([eventId, poolType])
  @@map("exam_pools")
}

model PoolMembership {
  id               String           @id @default(cuid())
  poolId           String
  userId           String
  examComponentId  String?
  bookingId        String?
  sourceAutoPoolId String?
  status           MembershipStatus @default(RESERVED)
  amountReserved   Decimal          @db.Decimal(10, 2)
  amountPaid       Decimal?         @db.Decimal(10, 2)
  discountType     String?
  referralCode     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  confirmedAt      DateTime?
  paidAt           DateTime?
  paymentReference String?
  booking          ExamBooking?     @relation(fields: [bookingId], references: [id])
  examComponent    ExamComponent?   @relation(fields: [examComponentId], references: [id])
  pool             ExamPool         @relation(fields: [poolId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([poolId, userId])
  @@index([poolId])
  @@index([userId])
  @@index([status])
  @@index([examComponentId])
  @@index([poolId, status])
  @@index([bookingId])
  @@index([deletedAt])
  @@map("pool_memberships")
}

model PoolWaitlist {
  id              String        @id @default(cuid())
  poolId          String
  userId          String
  examComponentId String
  priority        Int           @default(0)
  status          String        @default("PENDING")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  examComponent   ExamComponent @relation(fields: [examComponentId], references: [id])
  pool            ExamPool      @relation(fields: [poolId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([poolId, userId, examComponentId])
  @@index([poolId])
  @@index([userId])
  @@index([examComponentId])
  @@map("pool_waitlist")
}

model Wallet {
  id               String              @id @default(cuid())
  userId           String              @unique
  balance          Decimal             @default(0) @db.Decimal(10, 2)
  reservedBalance  Decimal             @default(0) @db.Decimal(10, 2)
  availableBalance Decimal             @default(0) @db.Decimal(10, 2)
  currency         String              @default("EUR")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  transactions     WalletTransaction[]
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([availableBalance])
  @@map("wallets")
}

model WalletTransaction {
  id                 String              @id @default(cuid())
  walletId           String
  type               TransactionType
  amount             Decimal             @db.Decimal(10, 2)
  balanceBefore      Decimal?            @db.Decimal(10, 2)
  balanceAfter       Decimal?            @db.Decimal(10, 2)
  reservedBefore     Decimal?            @db.Decimal(10, 2)
  reservedAfter      Decimal?            @db.Decimal(10, 2)
  availableBefore    Decimal?            @db.Decimal(10, 2)
  availableAfter     Decimal?            @db.Decimal(10, 2)
  referenceType      String?
  referenceId        String?
  description        String?
  metadata           Json?
  createdAt          DateTime            @default(now())
  createdBy          String?
  examBookings       ExamBooking[]
  modularEnrollments ModularEnrollment[]
  paymentMilestones  PaymentMilestone[]
  tuitionBookings    TuitionBooking[]
  wallet             Wallet              @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([type])
  @@index([createdAt(sort: Desc)])
  @@index([referenceType, referenceId])
  @@index([walletId, createdAt(sort: Desc)])
  @@map("wallet_transactions")
}

model Exam {
  id              String        @id @default(cuid())
  examComponentId String
  eventId         String?
  name            String
  description     String?
  examDate        DateTime
  duration        Int
  passingScore    Decimal       @db.Decimal(5, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  bookings        ExamBooking[]
  results         ExamResult[]
  event           ExamEvent?    @relation(fields: [eventId], references: [id])
  examComponent   ExamComponent @relation(fields: [examComponentId], references: [id])

  @@index([examComponentId])
  @@index([examDate])
  @@map("exams")
}

model ExamBooking {
  id                 String             @id @default(cuid())
  userId             String
  examId             String?
  eventId            String?
  examComponentId    String?
  bookingType        BookingType        @default(INDIVIDUAL)
  moduleCode         String?
  amountPaid         Decimal            @db.Decimal(10, 2)
  status             PaymentStatus      @default(PENDING)
  walletTxnId        String?
  bookedAt           DateTime           @default(now())
  examDate           DateTime?
  bookingGroupRef    String?
  attemptType        String?
  result             String?
  score              Decimal?           @db.Decimal(5, 2)
  maxScore           Decimal?           @db.Decimal(5, 2)
  percentage         Decimal?           @db.Decimal(5, 2)
  sourceNotes        String?
  migrationRef       String?
  groupRepId         String?
  groupName          String?
  isResit            Boolean            @default(false)
  autoPoolId         String?
  combinedGroupRef   String?
  cancellationReason String?
  cancelledAt        DateTime?
  cancelledBy        String?
  refundAmount       Decimal?           @db.Decimal(10, 2)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?
  courseId            String?
  course             Course?            @relation(fields: [courseId], references: [id])
  event              ExamEvent?         @relation(fields: [eventId], references: [id])
  examComponent      ExamComponent?     @relation(fields: [examComponentId], references: [id])
  exam               Exam?              @relation(fields: [examId], references: [id])
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletTransaction  WalletTransaction? @relation(fields: [walletTxnId], references: [id])
  poolMemberships    PoolMembership[]

  @@index([userId])
  @@index([examId])
  @@index([eventId])
  @@index([status])
  @@index([bookingGroupRef])
  @@index([migrationRef])
  @@index([examComponentId])
  @@index([moduleCode])
  @@index([autoPoolId])
  @@index([combinedGroupRef])
  @@index([deletedAt])
  @@map("exam_bookings")
}

model BookingEntitlement {
  id                String   @id @default(cuid())
  userId            String
  bookingGroupRef   String
  bookingType       String
  includedFreeResits Int      @default(0)
  usedFreeResits    Int      @default(0)
  transferable      Boolean  @default(false)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bookingGroupRef])
  @@index([userId])
  @@map("booking_entitlements")
}

model ExamResult {
  id                String    @id @default(cuid())
  examId            String
  userId            String
  score             Decimal   @db.Decimal(5, 2)
  maxScore          Decimal   @db.Decimal(5, 2)
  percentage        Decimal   @db.Decimal(5, 2)
  passed            Boolean
  grade             String?
  certificateUrl    String?
  certificateIssued DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  exam              Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@index([userId])
  @@map("exam_results")
}

model Payment {
  id                  String        @id @default(cuid())
  userId              String
  amount              Decimal       @db.Decimal(10, 2)
  currency            String        @default("EUR")
  paymentCurrency     String?       // The actual currency the user paid in (e.g., GHS, USD)
  originalAmount      Decimal?      @db.Decimal(10, 2) // Amount in paymentCurrency before conversion
  exchangeRate        Decimal?      @db.Decimal(12, 6) // Rate used for conversion
  paymentMethod       String
  status              PaymentStatus @default(PENDING)
  proofUrl            String?
  proofUploadedAt     DateTime?
  referenceCode       String?       @unique
  referenceType       String?
  referenceId         String?
  approvedAt          DateTime?
  approvedBy          String?
  rejectedAt          DateTime?
  rejectedBy          String?
  rejectionReason     String?
  reconciled          Boolean       @default(false)
  reconciledAt        DateTime?
  reconciledBy        String?
  reconciliationNotes String?
  notes               String?
  deletedAt           DateTime?     // Soft delete — retain payment records when user is deleted
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([approvedAt])
  @@index([referenceCode])
  @@index([referenceType, referenceId])
  @@map("payments")
}

model Invoice {
  id            String    @id @default(cuid())
  userId        String
  invoiceNumber String    @unique
  amount        Decimal   @db.Decimal(10, 2)
  currency      String    @default("EUR")
  items         Json
  status        String    @default("UNPAID")
  issuedAt      DateTime  @default(now())
  dueDate       DateTime?
  paidAt        DateTime?
  pdfUrl        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([invoiceNumber])
  @@index([status])
  @@map("invoices")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  readAt    DateTime?
  linkUrl   String?
  linkText  String?
  sentBy    String?
  metadata  Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  sender    User?            @relation("SentNotifications", fields: [sentBy], references: [id])
  user      User             @relation("ReceivedNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}

model Message {
  id          String    @id @default(cuid())
  senderId    String
  recipientId String
  subject     String?
  body        String
  isRead      Boolean   @default(false)
  readAt      DateTime?
  threadId    String?
  replyToId   String?
  attachments Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  recipient   User      @relation("ReceivedMessages", fields: [recipientId], references: [id])
  sender      User      @relation("SentMessages", fields: [senderId], references: [id])

  @@index([senderId])
  @@index([recipientId])
  @@index([isRead])
  @@index([threadId])
  @@index([createdAt(sort: Desc)])
  @@map("messages")
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entity      String?
  entityId    String?
  description String?
  changes     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  type        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@index([key])
  @@map("system_settings")
}

model PaymentMethod {
  id                String   @id @default(cuid())
  type              String
  label             String
  currency          String
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  bankSwiftCode     String?
  bankBranch        String?
  momoProvider      String?
  momoNumber        String?
  momoMerchantCode  String?
  momoAccountName   String?
  stripeAccountId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("payment_methods")
}

model FileUpload {
  id            String   @id @default(cuid())
  userId        String
  filename      String
  originalName  String
  mimeType      String
  size          Int
  url           String
  fileType      String
  referenceType String?
  referenceId   String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([fileType])
  @@index([referenceType, referenceId])
  @@map("file_uploads")
}

model NewsArticle {
  id                String            @id @default(cuid())
  title             String
  slug              String            @unique
  excerpt           String?
  content           String
  coverImage        String?
  status            NewsArticleStatus @default(DRAFT)
  authorId          String
  customAuthorName  String?
  viewCount         Int               @default(0)
  tags              String[]          @default([])
  publishedAt       DateTime?
  customPublishedAt DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  author            User              @relation(fields: [authorId], references: [id])

  @@index([slug])
  @@index([status])
  @@index([publishedAt])
  @@map("news_articles")
}

model GeneralResource {
  id                String   @id @default(cuid())
  name              String
  description       String?
  url               String
  type              String
  category          String
  showToInstructors Boolean  @default(true)
  showToStaff       Boolean  @default(true)
  showToStudents    Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([category])
  @@index([showToInstructors])
  @@index([showToStaff])
  @@index([showToStudents])
  @@map("general_resources")
}

model AcademicYear {
  id              String           @id @default(cuid())
  name            String           @unique
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  classes         Class[]
  enrollments     Enrollment[]
  semesters       Semester[]
  studentProfiles StudentProfile[]

  @@map("academic_years")
}

model Semester {
  id              String           @id @default(cuid())
  name            String
  academicYearId  String
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  classes         Class[]
  enrollments     Enrollment[]
  academicYear    AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  studentProfiles StudentProfile[]

  @@index([academicYearId])
  @@map("semesters")
}

model FullTimeProgramme {
  id             String               @id @default(cuid())
  code           String               @unique
  name           String
  durationYears  Int
  totalFee       Decimal              @db.Decimal(10, 2)
  currency       String               @default("EUR")
  description    String?
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  enrollments    FullTimeEnrollment[]
  programmeYears ProgrammeYear[]

  @@map("full_time_programmes")
}

model ProgrammeYear {
  id                  String               @id @default(cuid())
  programmeId         String
  yearNumber          Int
  yearFeeAmount       Decimal?             @db.Decimal(10, 2)
  seatConfirmationFee Decimal              @default(1500) @db.Decimal(10, 2)
  firstPaymentAmount  Decimal              @default(3500) @db.Decimal(10, 2)
  semesters           Json                 @default("[]")
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  enrollments         FullTimeEnrollment[]
  programme           FullTimeProgramme    @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  courses             Course[]             @relation("CourseToProgrammeYear")

  @@unique([programmeId, yearNumber])
  @@map("programme_years")
}

model FullTimeEnrollment {
  id                String             @id @default(cuid())
  studentId         String
  programmeId       String
  programmeYearId   String
  status            String             @default("PENDING_CONFIRMATION")
  currentYearNumber Int                @default(1)
  startDate         DateTime           @default(now())
  academicYear      String?            @default("2026/2027")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  programme         FullTimeProgramme  @relation(fields: [programmeId], references: [id])
  programmeYear     ProgrammeYear      @relation(fields: [programmeYearId], references: [id])
  student           User               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  ojtPeriods        OjtPeriod[]
  milestones        PaymentMilestone[]

  @@unique([studentId, programmeId])
  @@map("full_time_enrollments")
}

model OjtPeriod {
  id              String             @id @default(cuid())
  enrollmentId    String
  companyName     String
  companyAddress  String?
  supervisorName  String?
  supervisorEmail String?
  startDate       DateTime
  endDate         DateTime?
  status          String             @default("PENDING")
  hoursCompleted  Int                @default(0)
  hoursRequired   Int                @default(2000)
  reportUrl       String?
  verifiedBy      String?
  verifiedAt      DateTime?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  enrollment      FullTimeEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
  @@index([status])
  @@map("ojt_periods")
}

model PaymentMilestone {
  id                String             @id @default(cuid())
  enrollmentId      String
  yearNumber        Int
  milestoneType     String
  dueDate           DateTime
  percentOfYearFee  Decimal            @db.Decimal(5, 2)
  amountDue         Decimal            @db.Decimal(10, 2)
  status            String             @default("DUE")
  paidAt            DateTime?
  walletTxnId       String?
  createdAt         DateTime           @default(now())
  enrollment        FullTimeEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  walletTransaction WalletTransaction? @relation(fields: [walletTxnId], references: [id])

  @@index([enrollmentId])
  @@map("payment_milestones")
}

model ModularPackage {
  id              String              @id @default(cuid())
  name            String
  description     String?
  price           Decimal             @db.Decimal(10, 2)
  modulesIncluded String[]
  durationMonths  Int?
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  enrollments     ModularEnrollment[]

  @@map("modular_packages")
}

model ModularEnrollment {
  id                String             @id @default(cuid())
  studentId         String
  packageId         String
  status            String             @default("DRAFT")
  amountPaid        Decimal            @db.Decimal(10, 2)
  walletTxnId       String?
  validFrom         DateTime?
  validUntil        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  package           ModularPackage     @relation(fields: [packageId], references: [id])
  student           User               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  walletTransaction WalletTransaction? @relation(fields: [walletTxnId], references: [id])

  @@index([studentId])
  @@index([packageId])
  @@map("modular_enrollments")
}

model TuitionRun {
  id                 String           @id @default(cuid())
  title              String
  moduleTag          String?
  description        String?
  startDatetime      DateTime
  endDatetime        DateTime
  capacity           Int
  minClassSize       Int              @default(5)
  currentEnrollments Int              @default(0)
  price              Decimal          @db.Decimal(10, 2)
  status             String           @default("SCHEDULED")
  createdById        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  bookings           TuitionBooking[]
  creator            User?            @relation("CreatedTuitionRuns", fields: [createdById], references: [id])

  @@map("tuition_runs")
}

model TuitionBooking {
  id                String             @id @default(cuid())
  tuitionRunId      String
  studentId         String
  status            String             @default("DRAFT")
  amountPaid        Decimal            @db.Decimal(10, 2)
  walletTxnId       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  student           User               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tuitionRun        TuitionRun         @relation(fields: [tuitionRunId], references: [id])
  walletTransaction WalletTransaction? @relation(fields: [walletTxnId], references: [id])

  @@unique([tuitionRunId, studentId])
  @@map("tuition_bookings")
}

model EmailTemplate {
