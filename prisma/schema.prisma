/// Structured interview evaluation form filled by each interviewer per applicant.
/// Multiple evaluators can independently assess the same applicant.
/// Scores are averaged for composite shortlisting decisions.
model InterviewEvaluation {
  id            String @id @default(cuid())
  applicationId String
  evaluatorId   String

  // Structured rubric scores (1-10 scale per dimension)
  communicationScore   Int // Verbal clarity, confidence, articulation
  technicalScore       Int // Technical aptitude, aviation knowledge
  motivationScore      Int // Drive, career goals, commitment to aviation
  problemSolvingScore  Int // Analytical thinking, situational responses
  teamworkScore        Int // Collaboration, interpersonal skills
  professionalismScore Int // Presentation, punctuality, demeanor

  // Per-dimension remarks
  communicationNotes   String?
  technicalNotes       String?
  motivationNotes      String?
  problemSolvingNotes  String?
  teamworkNotes        String?
  professionalismNotes String?

  // Overall assessment
  overallImpression Int // 1-10 overall impression
  recommendation    InterviewRecommendation
  personalScore     Int // 0-100 — evaluator's personal composite score
  generalRemarks    String? // Free-form remarks and observations

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  evaluator   User        @relation("InterviewEvaluator", fields: [evaluatorId], references: [id])

  @@unique([applicationId, evaluatorId])
  @@index([applicationId])
  @@map("interview_evaluations")
}

