/// Many-to-many join between instructors and exam banks with edit permission
/// NOTE: instructorId references InstructorProfile (not User.id as the UI plan
/// specifies). This divergence is intentional — changing it would require a data
/// migration and break existing functionality. The API layer handles mapping
/// between User.id and InstructorProfile.id where needed.
model InternalExamBankInstructor {
  id             String          @id @default(cuid())
  bankId         String
  instructorId   String
  canEdit        Boolean         @default(false)
  canReview      Boolean         @default(false)
  canMonitor     Boolean         @default(false)
  canPublish     Boolean         @default(false)
  assignedBy     String?
  assignedAt     DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  bank           InternalExamBank @relation(fields: [bankId], references: [id], onDelete: Cascade)
  instructor     InstructorProfile @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@unique([bankId, instructorId])
  @@index([instructorId])
  @@map("internal_exam_bank_instructors")
}

/// Scheduled exam window for a class using a specific bank
model InternalExamClassSchedule {
  id              String          @id @default(cuid())
  bankId          String
  classId         String?
  scheduledStart  DateTime?
  scheduledEnd    DateTime?
  isActive        Boolean         @default(true)
  allowLateStart  Boolean         @default(false)
  sebRequired     Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  bank            InternalExamBank @relation(fields: [bankId], references: [id], onDelete: Cascade)
  class           Class?          @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([bankId])
  @@index([classId])
  @@map("internal_exam_class_schedules")
}

/// Single-use access code granting entry to an exam session
model InternalExamAccessCode {
  id          String             @id @default(cuid())
  code        String             @unique
  sessionId   String
  candidateId String?
  used        Boolean            @default(false)
  usedAt      DateTime?
  expiresAt   DateTime
  createdAt   DateTime           @default(now())
  session     InternalExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([candidateId])
  @@map("internal_exam_access_codes")
}

/// Proctoring violation logged during an exam session
model InternalExamViolation {
  id          String             @id @default(cuid())
  sessionId   String
  studentId   String
  classId     String?
  bankId      String
  type        String
  severity    String             @default("WARNING")
  detail      String?
  deviceInfo  Json?
  reviewed    Boolean            @default(false)
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewOutcome String?
  createdAt   DateTime           @default(now())
  session     InternalExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student     User               @relation("InternalExamViolationStudent", fields: [studentId], references: [id], onDelete: Cascade)
  bank        InternalExamBank    @relation(fields: [bankId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([studentId])
  @@index([bankId])
  @@map("internal_exam_violations")
}

/// Generated certificate for a completed exam session
model Certificate {
  id            String   @id @default(cuid())
  certificateId String   @unique
  sessionId     String   @unique
  studentId     String
  courseId      String?
  moduleCode    String?
  score         Int?
  percentage    Float?
  template      String   @default("internal_exam")
  pdfUrl        String?
  issuedAt      DateTime @default(now())
  issuedBy      String?
  verified      Boolean  @default(false)
  revokedAt     DateTime?
  revokedBy     String?
  revokeReason  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  retentionCategory RetentionCategory @default(CERTIFICATE)
  session       InternalExamSession? @relation(fields: [sessionId], references: [id])
  student       User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([sessionId])
  @@map("certificates")
}

enum PdfTemplateType {
  CERTIFICATE
  TRANSCRIPT
}

enum PdfTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// Stores template configurations for data-driven PDF generation.
/// Staff can customise text content, signatures, branding, and numbering format per template.
model PdfTemplate {
  id                String                @id @default(cuid())
  name              String                @unique
  slug              String                @unique
  type              PdfTemplateType
  layout            String                @default("default")
  status            PdfTemplateStatus     @default(DRAFT)
  isDefault         Boolean               @default(false)
  /// JSON: title, subtitle, completionText, accreditationText, signatureLabels, etc.
  content           Json                  @default("{}")
  /// JSON: logoUrl, watermarkUrl, watermarkOpacity, footerText (overrides global)
  branding          Json?
  /// e.g. "CERT-{YYYY}-{SEQ:4}"
  numberFormat      String?
  lastSequence      Int                   @default(0)
  lastSequenceYear  Int?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  createdBy         String?
  updatedBy         String?
  clonedFromId      String?
  signatures        PdfTemplateSignature[]
  verifications     DocumentVerification[]

  @@index([type, isDefault])
  @@index([status])
  @@map("pdf_templates")
}

/// Uploaded digital signature images stored in Supabase Storage.
model PdfSignature {
  id          String                  @id @default(cuid())
  /// Role title, e.g. "Training Manager", "Academy Director"
  label       String
  /// Full name of the person whose signature this is, e.g. "Capt. John Doe"
  signerName  String
  /// Supabase Storage path: "signatures/{id}.png"
  imageUrl    String
  isActive    Boolean                 @default(true)
  sortOrder   Int                     @default(0)
  /// When set, this signature should be rotated (staff role change, etc.)
  expiresAt   DateTime?
  /// User ID of the admin who uploaded this signature
  uploadedBy  String?
  /// User ID of the person whose consent was obtained for this signature
  consentGivenBy String?
  /// How consent was obtained: "in_person", "email", "verbal", "written"
  consentMethod  String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  templates   PdfTemplateSignature[]

  @@map("pdf_signatures")
}

/// Join table: assigns a PdfSignature to a PdfTemplate position (left/right slot).
model PdfTemplateSignature {
  id          String       @id @default(cuid())
  templateId  String
  signatureId String
  /// 0 = left slot, 1 = right slot
  position    Int          @default(0)
  template    PdfTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  signature   PdfSignature @relation(fields: [signatureId], references: [id], onDelete: Cascade)

  @@unique([templateId, position])
  @@map("pdf_template_signatures")
}

/// Public-facing verification record created when a document is generated.
/// Used by the QR code verification page — no auth required.
model DocumentVerification {
  id              String       @id @default(cuid())
  /// Short unique code shown in QR, e.g. "AJ-2026-A7X9K2"
  code            String       @unique
  templateId      String?
  recipientName   String
  /// e.g. "Certificate" | "Transcript"
  documentType    String
  certificateNo   String?      @unique
  issueDate       DateTime
  metadata        Json?
  generatedBy     String?
  /// When set, this verification record expires (e.g. for re-issued docs)
  expiresAt       DateTime?
  /// When set, this verification record has been revoked
  revokedAt       DateTime?
  /// User ID of the admin who revoked this record
  revokedBy       String?
  revokeReason    String?
  createdAt       DateTime     @default(now())
  template        PdfTemplate? @relation(fields: [templateId], references: [id])

  @@index([code])
  @@index([recipientName])
  @@map("document_verifications")
}

