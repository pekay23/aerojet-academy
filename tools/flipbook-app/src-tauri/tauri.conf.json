{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flipbook Scraper",
  "version": "0.1.0",
  "identifier": "com.aerojet.flipbook-scraper",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Flipbook Scraper",
        "width": 900,
        "height": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/128x128.png", "icons/128x128@2x.png", "icons/32x32.png"]
  },
  "plugins": {}
}
